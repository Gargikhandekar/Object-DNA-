# Copy to .env (repository root) and adjust. All variables are optional.

# Where the SQLite database, uploaded images, fingerprints and weights live.
# Default: <repo>/data. Use an ABSOLUTE path if you override it.
# ODNA_DATA_DIR=C:/object-dna-data
# ODNA_DATABASE_URL=sqlite:///C:/object-dna-data/object_dna.db
# ODNA_WEIGHTS_DIR=C:/object-dna-data/models

# Deep embedding backbone: resnet50 | dinov2_vits14 | none
# Weights must be downloaded first: python scripts/download_weights.py --backbone resnet50
ODNA_EMBEDDING_BACKBONE=resnet50
ODNA_DEVICE=cpu

# Upload limits
ODNA_MAX_UPLOAD_MB=15
ODNA_MAX_IMAGES_PER_REQUEST=30

# Preprocessing
ODNA_PROCESSING_MAX_SIDE=640
ODNA_USE_FOREGROUND_MASK=true
ODNA_CROP_TO_FOREGROUND=false

# Matching
ODNA_ORB_NFEATURES=1500
ODNA_ORB_RATIO=0.75
ODNA_RANSAC_REPROJ_THRESHOLD=6.0
# Only run ORB against the N best objects by global descriptors (0 = all objects)
ODNA_ORB_SHORTLIST=0

# Default decision thresholds (used until a validation-tuned fusion config is applied
# from the Research Lab, which writes experiments/configs/active_fusion.json)
ODNA_ACCEPT_THRESHOLD=0.55
ODNA_UNCERTAIN_THRESHOLD=0.35
ODNA_MARGIN_THRESHOLD=0.05

# CORS origins for the frontend dev server (JSON list)
ODNA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
